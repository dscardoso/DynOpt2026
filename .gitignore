# Files generated by invoking Julia with --code-coverage or --track-allocation
*.jl.cov
*.jl.*.cov
*.jl.mem

# Manifest.toml is deliberately COMMITTED for this repository. This is a workshop,
# not a package: every participant must get identical package versions.

# Local preferences
LocalPreferences.toml
JuliaLocalPreferences.toml

# Figures written by the exercise scripts
*.png
!slides/**/*.png

# Quarto build artifacts and caches (slides are rendered by the instructor)
/.quarto/
.cache/
slides/**/.jupyter_cache/
